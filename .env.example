# Copy to /opt/proxyscrape/.env on the host and fill in real values. NOT tracked in git.
# YYDS Mail API key used by proxyscrape_register.py.
YYDS_API_KEY=your-yyds-api-key-here
# healthchecks ping URL - a CAPABILITY TOKEN (holder can mark the check healthy),
# so the REAL value lives ONLY in /opt/proxyscrape/.env and must never be committed.
# Loopback form (same box as healthchecks; no DNS/Cloudflare dependency):
PING_URL=http://127.0.0.1:8120/ping/00000000-0000-0000-0000-000000000000
